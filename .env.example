# Local development credentials only. Keep DATABASE_URL in sync with POSTGRES_*.
POSTGRES_USER=say_ai
POSTGRES_PASSWORD=say_ai_local
POSTGRES_DB=say_ai
POSTGRES_PORT=5433
DATABASE_URL=postgresql://say_ai:say_ai_local@127.0.0.1:5433/say_ai
PORT=3000
# Generate a secret with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
DEVELOPER_API_KEY=
DEVELOPER_OWNER_ID=anton
# Optional server key for developer HTTP bases. Telegram owners connect their own keys in the manager.
# Ingestion starts when this key or Telegram is configured. Set false to pause it.
OPENAI_API_KEY=
# INGESTION_ENABLED=true
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Optional Telegram integration. Leave the manager token empty to disable it.
# When enabled, the manager token and both secrets below are required.
TELEGRAM_MANAGER_TOKEN=
# Required webhook secret. Generate once with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
TELEGRAM_WEBHOOK_SECRET=
# Required master encryption key. Preserve it to decrypt bot tokens and owner OpenAI keys:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
TELEGRAM_TOKEN_ENCRYPTION_KEY=
# npm run dev:public supplies the public URL automatically; no value is needed here.
# For npm run dev or npm start with Telegram enabled, set a public HTTPS base URL
# forwarding to this server, without /telegram/webhook.
# TELEGRAM_PUBLIC_URL=https://api.example.com
# Optional daily question limit per owner. Defaults to 100 when omitted.
# Successful and failed admitted questions share this allowance (database date).
# TELEGRAM_DAILY_QUERY_LIMIT=100
