{
  "name": "say-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "RUN_LIVE_QUERY_TEST=false RUN_LIVE_EMBEDDING_TEST=false RUN_LIVE_IMAGE_TEST=false node --env-file-if-exists=.env --import tsx --test tests/*.test.mjs",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "db:up": "docker compose up -d --wait",
    "db:stop": "docker compose stop",
    "db:migrate": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js up",
    "db:rollback": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js down 1",
    "db:check": "node --env-file-if-exists=.env --import tsx scripts/check-db.ts",
    "pilot:status": "node --env-file-if-exists=.env scripts/pilot-status.mjs",
    "test:db": "node --env-file-if-exists=.env --test tests/database.test.mjs",
    "test:api": "node --env-file-if-exists=.env --import tsx --test tests/api.test.mjs",
    "test:uploads": "node --env-file-if-exists=.env --import tsx --test tests/uploads.test.mjs tests/chunk-preparation.test.mjs",
    "test:documents": "node --import tsx --test tests/documents.test.mjs",
    "test:ingestion": "node --env-file-if-exists=.env --import tsx --test tests/ingestion.test.mjs",
    "test:queries": "node --env-file-if-exists=.env --import tsx --test tests/queries.test.mjs tests/conversation.test.mjs",
    "test:replacement": "node --env-file-if-exists=.env --import tsx --test tests/replacement.test.mjs",
    "test:telegram": "node --env-file-if-exists=.env --import tsx --test tests/telegram.test.mjs",
    "test:server-limits": "node --import tsx --test tests/server-limits.test.mjs",
    "dev:public": "node --env-file-if-exists=.env scripts/dev-public.mjs",
    "test:dev-public": "node --test tests/dev-public.test.mjs",
    "test:owner-keys": "node --env-file-if-exists=.env --import tsx --test tests/owner-openai.test.mjs",
    "test:images": "node --env-file-if-exists=.env --import tsx --test tests/images.test.mjs tests/image-sources.test.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "express": "^5.3.0",
    "js-tiktoken": "^1.0.21",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/word-extractor": "^1.0.6",
    "jszip": "^3.10.2",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
