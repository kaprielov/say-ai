{
  "name": "say-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "db:up": "docker compose up -d --wait",
    "db:stop": "docker compose stop",
    "db:migrate": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js up",
    "db:rollback": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js down 1",
    "db:check": "node --env-file-if-exists=.env --import tsx scripts/check-db.ts",
    "test:db": "node --env-file-if-exists=.env --test tests/database.test.mjs",
    "test:api": "node --env-file-if-exists=.env --import tsx --test tests/api.test.mjs",
    "test:ingestion": "node --env-file-if-exists=.env --import tsx --test tests/ingestion.test.mjs",
    "test:queries": "node --env-file-if-exists=.env --import tsx --test tests/queries.test.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "express": "^5.3.0",
    "js-tiktoken": "^1.0.21",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
